# Copy this file to .env.local and fill in the values.
# Use the same two values as Pantry's .env.local (same Supabase project).
# Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Push notifications (step 10). Generate with:  npx web-push generate-vapid-keys
# Only the PUBLIC key goes here. The private key goes in Supabase secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
